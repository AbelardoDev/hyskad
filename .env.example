# Variables de entorno de HYSKAD. Copia este archivo a .env y ajusta los valores.
# .env NUNCA se sube al repositorio. En dev, el backend tiene valores por defecto para todo
# lo que está aquí, así que el .env solo hace falta si quieres cambiarlos.

# --- Base de datos ---
# URL JDBC de MySQL (en prod apunta al servicio de la red interna de Docker, p. ej. mysql:3306)
DB_URL=jdbc:mysql://localhost:3306/hyskad?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USER=hyskad
DB_PASSWORD=cambia_esta_clave
# Solo lo usa el contenedor de MySQL
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root

# --- Seguridad ---
# Clave para firmar los JWT: mínimo 256 bits en base64. Genérala con: openssl rand -base64 48
JWT_SECRET=

# --- Correo (Mailpit en dev; SMTP externo como Brevo/Gmail en prod) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
# Remitente de los correos del sistema
MAIL_FROM=no-reply@hyskad.local

# --- Aplicación ---
# URL pública del frontend (enlaces en correos, CORS en dev)
APP_BASE_URL=http://localhost:4200

# --- Primer administrador ---
# Solo se usan para crear el primer admin si no existe ninguno.
ADMIN_EMAIL=
ADMIN_PASSWORD=
