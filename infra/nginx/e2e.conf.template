# Nginx de las pruebas E2E: estáticos de Angular y proxy de /api al backend que corre en el host.
# Plantilla: la imagen de nginx sustituye ${BACKEND_PORT} al arrancar.
server {
    listen 80;
    root /usr/share/nginx/html;

    # SSE (RF30): sin búfer ni caché y con lectura larga, o los eventos llegan tarde o en bloque.
    # La configuración de producción (F13) debe repetir este bloque.
    location /api/v1/notificaciones/stream {
        proxy_pass http://host.docker.internal:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://host.docker.internal:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
