# Nginx de producción (F13): SPA de Angular, proxy de /api al backend y HTTPS con Let's Encrypt.
# Plantilla: la imagen oficial de nginx sustituye ${DOMINIO} al arrancar (variable del compose).

server_tokens off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types text/plain text/css text/csv application/javascript application/json application/manifest+json image/svg+xml;

# --- HTTP: solo el reto de Let's Encrypt; lo demás va a HTTPS (IC1, CP-63) ----------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS --------------------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
    # Perfil "intermediate" de Mozilla
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    client_max_body_size 5m;

    include /etc/nginx/snippets/csp-hashes.conf;
    include /etc/nginx/snippets/seguridad.conf;

    # Documentación de la API y actuator nunca desde fuera (el backend ya los apaga en prod)
    location ^~ /api/docs { return 404; }
    location ^~ /actuator { return 404; }

    # SSE (RF30): sin búfer ni caché y con lectura larga, o los eventos llegan tarde o en bloque
    location = /api/v1/notificaciones/stream {
        proxy_pass http://backend:8080;
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://backend:8080;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Archivos con hash en el nombre: no cambian nunca
    location ~ ^/(?:chunk-|main-|polyfills-|styles-|media/) {
        try_files $uri =404;
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /brand/ {
        try_files $uri =404;
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # SPA: cualquier otra ruta es de Angular; index.html siempre se revalida
    location / {
        try_files $uri /index.html;
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "no-cache" always;
    }
}
