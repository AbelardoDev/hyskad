# Variables de producción (F13). Copiar a /opt/hyskad/.env en el VPS y completar.
# Este archivo NO lleva valores reales; el .env real nunca se sube al repositorio.
# Permisos recomendados en el servidor: chmod 600 /opt/hyskad/.env

# --- Dominio y versión ---------------------------------------------------------------------
# Subdominio con un registro A hacia la IP del VPS (sin https://)
DOMINIO=hyskad.tudominio.com
# Correo para avisos de Let's Encrypt (vencimiento del certificado)
LETSENCRYPT_EMAIL=
# Versión de las imágenes (la fija el pipeline de despliegue; latest = la última publicada)
HYSKAD_VERSION=latest

# --- Base de datos -------------------------------------------------------------------------
# Generar cada contraseña con: openssl rand -base64 24
DB_USER=hyskad
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Seguridad -----------------------------------------------------------------------------
# Secreto del JWT, al menos 256 bits en base64: openssl rand -base64 48
# Cambiarlo cierra todas las sesiones (ver "Rotar JWT_SECRET" en docs/DEPLOY.md)
JWT_SECRET=

# --- Correo (SMTP externo con STARTTLS) ----------------------------------------------------
# Ejemplos: Brevo smtp-relay.brevo.com:587 · Gmail smtp.gmail.com:587 (contraseña de aplicación)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Remitente verificado en el proveedor, p. ej. "HYSKAD <taller@tudominio.com>"
MAIL_FROM=

# --- Primer administrador (RN-46) ----------------------------------------------------------
# Solo se usan si no existe ningún administrador. Tras el primer ingreso (que exige cambiar la
# contraseña) borrar ADMIN_PASSWORD de este archivo y reiniciar el backend.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Memoria (valores para un VPS de 2 GB; ver docs/DEPLOY.md para 1 GB o 4 GB) ------------
BACKEND_MEM=768m
MYSQL_MEM=768m
MYSQL_BUFFER_POOL=256M
PROXY_MEM=128m
